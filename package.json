{
  "name": "macrofactor-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:init": "wrangler d1 execute macrofactor --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute macrofactor --file=./schema.sql --local",
    "ingest": "node scripts/ingest.mjs",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "doc-drift": "node scripts/doc-drift.mjs",
    "test": "vitest run",
    "db:migrate": "wrangler d1 execute macrofactor --file=./migrations/0001_claims.sql --remote"
  },
  "dependencies": {
    "agents": "^0.17.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
